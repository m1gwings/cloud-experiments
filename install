#!/usr/bin/env python3
"""Idempotent user-local symlink installer; never reads credentials."""
import os
from pathlib import Path
import shutil
import sys

if sys.version_info < (3, 11):
    sys.exit("Python 3.11+ is required.")
root = Path(__file__).resolve().parent
missing = [name for name in ("git", "hcloud", "rclone", "ssh", "scp") if not shutil.which(name)]
if missing:
    sys.exit("Install these dependencies first: " + ", ".join(missing))
destination = Path.home() / ".local/bin"
destination.mkdir(parents=True, exist_ok=True)
commands = sorted((root / "bin").glob("cloud-*"))
for source in commands:
    target = destination / source.name
    if (target.exists() or target.is_symlink()) and target.resolve() != source.resolve():
        sys.exit(f"Refusing to replace unrelated command: {target}")
for source in commands:
    target = destination / source.name
    if not target.is_symlink():
        target.symlink_to(source)
    print(f"Installed {source.name}")
if str(destination) not in os.environ.get("PATH", "").split(os.pathsep):
    print('Add this to your shell profile: export PATH="$HOME/.local/bin:$PATH"')
print("Ready. Run cloud-doctor for offline diagnostics.")
